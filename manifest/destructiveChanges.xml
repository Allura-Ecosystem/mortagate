<?xml version="1.0" encoding="UTF-8"?>
<!--
  Borrower-facing decision-engine deprecation (product is now auditor-only).
  Removes the borrower onboarding UI and its soft pre-check Apex.

  Shared/audit kernel (PolicyRuleEvaluator, ReplayService, ReplayCommitService)
  and auditor screens are intentionally NOT listed — they are live CaseFile code.

  The retired origination classes (FactAssemblerService, LoanDecisionService,
  DecisionCommitService, DecisionReceiptController, AdverseActionNoticeController
  and their tests/pages) are ALSO intentionally NOT listed. Per ADR-32 (2026-08-02)
  they are quarantined at class level via .forceignore, not destructively removed:
  source is retained for audit/replay provenance and the 5 legacy objects stay
  deployed (Audit_Case__c has a hard lookup to Loan__c). Deleting that source was
  explicitly rejected. Do not add them here without superseding ADR-32.
-->
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <types>
        <members>OnboardingController</members>
        <members>PreFlightController</members>
        <members>PreFlightControllerTest</members>
        <members>PreFlightEvaluator</members>
        <members>PreFlightEvaluatorTest</members>
        <name>ApexClass</name>
    </types>
    <types>
        <members>welcomeGate</members>
        <members>intentCapture</members>
        <members>onboardingOrchestrator</members>
        <members>preCheckResult</members>
        <members>decisionRoom</members>
        <members>outcomeView</members>
        <members>evidenceQueue</members>
        <name>LightningComponentBundle</name>
    </types>
    <version>66.0</version>
</Package>
